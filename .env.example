PORT=3000
NODE_ENV=production
# Configure a compatible chat-completions provider on the SERVER only.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
# Optional: set a longer timeout in milliseconds (default 45000)
AI_TIMEOUT_MS=45000

# Optional output cap (128–2000 tokens; default 1200)
AI_MAX_TOKENS=1200
# Set to 1 only behind a trusted reverse proxy, for correct client IP rate limiting
TRUST_PROXY=0
